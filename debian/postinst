#!/bin/sh
# Build the initramfs for the running kernel. Only the running kernel: an
# older kernel keeps its previous initrd, which is the way back if wisp does
# not boot this machine. Set WISP_NO_BUILD=1 to skip (e.g. in a chroot).
set -e
case "$1" in
configure)
	if [ -z "$WISP_NO_BUILD" ]; then
		v=$(uname -r)
		if [ -f "/boot/vmlinuz-$v" ] && [ -d "/lib/modules/$v" ]; then
			if ! wisp build -k "$v"; then
				echo "wisp: building the initramfs for $v failed; /boot/initrd.img-$v was left unchanged" >&2
				exit 1
			fi
		else
			echo "wisp: no kernel $v under /boot, no initramfs built now (the kernel hook will)" >&2
		fi
	fi
	;;
esac
#DEBHELPER#
